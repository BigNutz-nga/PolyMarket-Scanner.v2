# Kalshi API credentials, needed for the CF Benchmarks index feed (the settlement reference).
# Create a read-only key at kalshi.com -> Account -> API keys. Keep the private key file
# outside this repository and never paste its contents anywhere.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-private-key.pem
# Only if the key file is passphrase-protected:
# KALSHI_PRIVATE_KEY_PASSWORD=
